{
	"name": "@riser-bob/cookie",
	"version": "0.1.1",
	"description": "Secure cookie utilities for the RiserBob framework",
	"type": "module",
	"main": "./dist/cookie.js",
	"module": "./dist/cookie.js",
	"types": "./dist/cookie.d.ts",
	"exports": {
		".": {
			"types": "./dist/cookie.d.ts",
			"import": "./dist/cookie.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun build cookie.ts --outdir dist --target bun --minify && tsc -p tsconfig.build.json",
		"test:watch": "bun test --watch",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"cookie": "^2.0.1"
	}
}
